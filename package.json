{
  "name": "cursor-goal",
  "private": true,
  "type": "module",
  "workspaces": ["packages/cursor-goal-runtime"],
  "scripts": {
    "build": "npm run build -w @cursor-goal/runtime",
    "test": "npm test -w @cursor-goal/runtime",
    "check": "npm run check -w @cursor-goal/runtime && node scripts/verify-readme-claims.mjs && node scripts/verify-capability.mjs",
    "test:invariants": "npm run test:invariants -w @cursor-goal/runtime",
    "test:fast": "npm run test:invariants -w @cursor-goal/runtime",
    "install:global": "bash scripts/install-global.sh",
    "install:repo": "bash core/install.sh",
    "uninstall:global": "bash scripts/uninstall-global.sh",
    "e2e:global": "bash scripts/e2e-global-cursor-agent.sh"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
