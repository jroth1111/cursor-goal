{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cursor-goal/work-units.json",
  "type": "object",
  "required": ["units"],
  "additionalProperties": false,
  "properties": {
    "units": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["id", "title", "scope", "acceptance", "status", "evidence_path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "title": { "type": "string" },
          "scope": { "type": "array", "items": { "type": "string" } },
          "acceptance": { "type": "array", "items": { "type": "string" } },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "evidence_received", "done"]
          },
          "subagent_id": { "type": ["string", "null"] },
          "evidence_path": {
            "type": "string",
            "pattern": "^evidence/units/[a-z0-9][a-z0-9_-]*\\.jsonl$"
          },
          "verified_by": { "type": ["string", "null"] },
          "verify_prompt": { "type": ["string", "null"] }
        }
      }
    }
  }
}
