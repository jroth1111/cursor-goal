{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cursor-goal/agent-runtime-state.json",
  "type": "object",
  "required": ["mode", "loop_count", "loop_limit", "phase", "blocked", "blockers", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "mode": { "type": "string", "enum": ["runtime", "minimal"] },
    "loop_count": { "type": "integer", "minimum": 0 },
    "loop_limit": { "type": "integer", "minimum": 1 },
    "phase": { "type": "string" },
    "blocked": { "type": "boolean" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "next_action": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["phase", "dispatch_unit", "fix_checks", "fix_scope", "fix_proxy", "fix_stale_proof", "fix_other"]
        },
        "headline": { "type": "string" },
        "detail": { "type": "string" },
        "task_prompt": { "type": "string" },
        "queue_index": { "type": "integer", "minimum": 0 },
        "unit_id": { "type": "string" }
      },
      "required": ["kind", "headline", "detail"]
    },
    "last_check_fail": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "cmd": { "type": "string" },
        "output": { "type": "string" },
        "at": { "type": "string" }
      },
      "required": ["cmd", "output", "at"]
    },
    "updated_at": { "type": "string" }
  }
}
