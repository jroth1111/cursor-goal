{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cursor-goal/orchestrator.json",
  "type": "object",
  "required": ["audit_dir", "marker", "required_done", "check_command"],
  "additionalProperties": false,
  "properties": {
    "audit_dir": { "type": "string", "minLength": 1 },
    "marker": { "type": "string", "minLength": 1 },
    "status_file": { "type": "string", "minLength": 1 },
    "master_status": { "type": "string", "minLength": 1 },
    "final_report": { "type": "string", "minLength": 1 },
    "required_done": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "check_command": { "type": "string", "minLength": 1 }
  }
}
