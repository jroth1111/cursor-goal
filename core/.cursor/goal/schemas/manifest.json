{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cursor-goal/manifest.json",
  "type": "object",
  "required": ["goal_id", "loop_limit", "compiled_at"],
  "additionalProperties": true,
  "properties": {
    "goal_id": { "type": "string", "minLength": 1 },
    "loop_limit": { "type": "integer", "minimum": 1 },
    "runtime": { "type": "string" },
    "compiled_at": { "type": "string" }
  }
}
