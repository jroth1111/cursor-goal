{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cursor-goal/trajectory.json",
  "type": "object",
  "required": ["phase"],
  "additionalProperties": true,
  "properties": {
    "phase": {
      "type": "string",
      "enum": ["INTAKE", "DISCOVERY", "PLAN", "IMPLEMENT", "VERIFY", "DONE"]
    },
    "sliceBudget": { "type": "integer", "minimum": 0 },
    "discovery_completed_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
