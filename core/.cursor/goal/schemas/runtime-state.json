{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cursor-goal/runtime-state.json",
  "type": "object",
  "required": ["mode", "total_blocked_stops", "loop_limit", "phase", "blocked_agent_count", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "mode": { "type": "string", "enum": ["runtime", "minimal"] },
    "total_blocked_stops": { "type": "integer", "minimum": 0 },
    "loop_limit": { "type": "integer", "minimum": 1 },
    "phase": { "type": "string" },
    "blocked_agent_count": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "string" }
  }
}
