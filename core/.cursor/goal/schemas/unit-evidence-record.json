{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "unit-evidence-record.json",
  "type": "object",
  "required": ["work_unit_id", "at", "evidence_version"],
  "properties": {
    "work_unit_id": { "type": "string", "minLength": 1 },
    "at": { "type": "string", "minLength": 1 },
    "evidence_version": { "type": "integer", "const": 1 },
    "subagent_id": { "type": "string" },
    "subagent_status": { "type": "string" },
    "status": { "type": "string" },
    "acceptance_ok": { "type": "boolean" },
    "acceptance": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blocked": { "type": "boolean" },
    "ok": { "type": "boolean" },
    "blocker": { "type": "string" }
  },
  "additionalProperties": true
}
