{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": "hooks/goal-session-start.sh" }],
    "beforeSubmitPrompt": [{ "command": "hooks/goal-prompt.sh" }],
    "preToolUse": [
      {
        "command": "hooks/goal-pre-tool.sh",
        "matcher": "Write|Edit|MultiEdit|Read|Grep|Glob|Task|WebFetch|WebSearch|MCP:.*"
      }
    ],
    "beforeShellExecution": [{ "command": "hooks/goal-shell.sh" }],
    "preCompact": [{ "command": "hooks/goal-pre-compact.sh" }],
    "postToolUse": [{ "command": "hooks/goal-post-tool.sh" }],
    "afterAgentResponse": [{ "command": "hooks/goal-after-response.sh" }],
    "stop": [
      {
        "command": "hooks/goal-stop.sh",
        "loop_limit": 40,
        "timeout": 600
      }
    ],
    "subagentStop": [{ "command": "hooks/goal-subagent-stop.sh" }],
    "sessionEnd": [{ "command": "hooks/goal-session-end.sh" }]
  }
}
