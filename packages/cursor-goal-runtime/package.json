{
  "name": "@cursor-goal/runtime",
  "version": "0.1.0",
  "description": "Optional full verifier and governance for cursor-goal (hooks dispatch here when built)",
  "type": "module",
  "bin": {
    "cursor-goal": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/link-hooks.mjs",
    "test": "npm run build && vitest --run",
    "test:invariants": "vitest --run tests/invariants tests/conformance",
    "test:hooks": "vitest --run tests/hooks",
    "check": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
