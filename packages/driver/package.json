{
  "name": "@cursor-goal/driver",
  "version": "0.1.0",
  "description": "Long-horizon driver for cursor-agent: owns the plan -> spawn -> verify -> continue loop until a goal's acceptance checks pass.",
  "type": "module",
  "bin": {
    "agent-driver": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "hooks"],
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "npm run build && vitest --run",
    "check": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
